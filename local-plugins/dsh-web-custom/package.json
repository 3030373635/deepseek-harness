{
  "name": "dsh-web-custom",
  "version": "0.1.0",
  "description": "Local login and interface customization for DeepSeek Harness Web",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./assets/*": "./lib/assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-web-custom-user": "./lib/create-user.js"
  },
  "files": ["lib", "auth.patch.yml", "ui.patch.yml"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": ["./auth.patch.yml", "./ui.patch.yml"] },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && ../../node_modules/.bin/tsdown --config tsdown.client.config.ts",
    "check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.4",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:../../packages/client/connection",
    "@deepseek-ai/dsh-credentials": "link:../../packages/credentials/credentials",
    "@deepseek-ai/dsh-host-webserver": "link:../../packages/host/webserver",
    "@deepseek-ai/schemastery": "link:../../vendor/schemastery",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
