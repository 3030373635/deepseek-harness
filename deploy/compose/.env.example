# Replace the address and URL with this Linux server's browser-facing address.
DSH_BIND_ADDRESS=192.168.3.86
DSH_HTTP_PORT=3080
DSH_PUBLIC_URL=http://192.168.3.86:3080

# Match the Linux user/group that owns the workspace (id -u and id -g).
DSH_UID=1000
DSH_GID=1000

# Web process home and workspace picker's starting directory inside the container.
DSH_WEB_HOME=/workspace

# Main interface browser-tab title; rebuild the image after changing it.
DSH_CLIENT_TITLE=衡枢

# Per-process Node heap limit (MiB) for serial aggregate type checks.
DSH_BUILD_CHECK_HEAP_MB=5120

# Optional build registry; leave empty to use the official npm registry.
DSH_NPM_REGISTRY=
