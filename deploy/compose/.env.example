# Set the server's LAN IP. Override DSH_PUBLIC_URL if browsers use a different HTTP address.
DSH_BIND_ADDRESS=192.168.3.86
DSH_HTTP_PORT=3080
DSH_PUBLIC_URL=http://${DSH_BIND_ADDRESS}:${DSH_HTTP_PORT:-3080}

# Match the Linux user/group that owns the workspace (id -u and id -g).
DSH_UID=1000
DSH_GID=1000

# Web process home and workspace picker's starting directory. Leave empty for /workspace.
DSH_WEB_HOME=

# Main interface browser-tab title; rebuild the image after changing it.
DSH_CLIENT_TITLE=衡枢

# Per-process Node heap limit (MiB) for serial aggregate type checks. Leave empty for the default.
DSH_BUILD_CHECK_HEAP_MB=

# Optional build registry; leave empty to use the official npm registry.
DSH_NPM_REGISTRY=
